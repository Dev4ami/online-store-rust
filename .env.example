# Template konfigurasi — SALIN ke .env lalu isi kredensial asli.
# Karakter spesial di password harus di-URL-encode (mis. @ -> %40).
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/online_store

BIND_ADDR=0.0.0.0:3000

# Cookie session hanya dikirim lewat HTTPS. WAJIB "true" di produksi (di belakang TLS).
# Biarkan false untuk dev lokal (HTTP) — kalau true di HTTP, login putus.
SECURE_COOKIES=false

# Set "true" bila di belakang reverse proxy tepercaya (Traefik/Coolify/Nginx) agar
# rate-limit login membaca IP klien asli dari X-Forwarded-For. JANGAN true bila app
# terekspos langsung ke internet — header bisa dipalsukan untuk mengelabui rate-limit.
TRUST_PROXY_HEADERS=false

RUST_LOG=online_store=debug,tower_http=debug,info

# Rahasia verifikasi webhook gateway dummy (dev). Ganti dgn secret gateway asli di produksi.
PAYMENT_DUMMY_SECRET=dev-dummy-secret

# Email akun admin yang dipastikan ada saat startup (opsional). Kosongkan bila tak dipakai.
ADMIN_EMAIL=

# Sandi untuk MEMBUAT akun admin bila ADMIN_EMAIL belum terdaftar (deploy toko baru
# langsung punya admin, tanpa register manual). Bila email sudah ada, akun itu cukup
# dipromosikan & sandi ini diabaikan (sandi lama tak ditimpa). Kosongkan bila tak perlu
# seed. GANTI setelah login pertama; jangan pakai sandi lemah di produksi.
ADMIN_PASSWORD=

# Nama toko yang tampil di brand header, footer, & judul tab. Default "Toko Online".
# Bila nilainya mengandung spasi, WAJIB pakai tanda kutip.
STORE_NAME="Toko Online"
