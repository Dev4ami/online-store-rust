# Template konfigurasi — SALIN ke .env lalu isi kredensial asli.
# Karakter spesial di password harus di-URL-encode (mis. @ -> %40).
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/online_store

BIND_ADDR=0.0.0.0:3000

RUST_LOG=online_store=debug,tower_http=debug,info

# Rahasia verifikasi webhook gateway dummy (dev). Ganti dgn secret gateway asli di produksi.
PAYMENT_DUMMY_SECRET=dev-dummy-secret

# Email akun yang otomatis dijadikan admin saat startup (opsional). Kosongkan bila tak dipakai.
ADMIN_EMAIL=
